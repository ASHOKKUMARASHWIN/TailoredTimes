# =============================================================
# TailoredTimes — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Option A: MongoDB Atlas (recommended for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tailoredtimes?retryWrites=true&w=majority
# Option B: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/tailoredtimes

# --- JWT Authentication ---
# Use a long, random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this_in_production
JWT_EXPIRES_IN=7d

# --- Admin ---
# Email of the developer/admin account. Must match registration email exactly.
ADMIN_EMAIL=ashwin92209@gmail.com

# --- Email Notifications (Nodemailer) ---
# Option A: Gmail with App Password (easiest for dev)
# 1. Enable 2FA on your Google account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password

# Option B: SendGrid (recommended for production)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.xxxx

# Recipient for new user registration notifications
NOTIFY_EMAIL=ashwin92209@gmail.com

# --- News APIs ---
# NewsAPI.org — Free at https://newsapi.org/register (100 req/day free tier)
# If left empty, the app falls back to RSS-only mode
NEWS_API_KEY=your_newsapi_org_key

# The Guardian Open Platform — Free at https://open-platform.theguardian.com/access/
# Used for 10-year archive (covers 2009+)
GUARDIAN_API_KEY=your_guardian_api_key

# --- Frontend ---
# Set this to your frontend URL for CORS (change in production)
FRONTEND_URL=http://localhost:5000
