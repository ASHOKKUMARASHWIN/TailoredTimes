# TailoredTimes - Local Development Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas - Direct connection (bypasses ISP SRV DNS block)
MONGODB_URI=mongodb://timestailored_db_user:KouNTTCEHNO8Nkys@ac-pkmwfab-shard-00-00.quqlcgz.mongodb.net:27017,ac-pkmwfab-shard-00-01.quqlcgz.mongodb.net:27017,ac-pkmwfab-shard-00-02.quqlcgz.mongodb.net:27017/tailoredtimes?ssl=true&replicaSet=atlas-t03na5-shard-0&authSource=admin&retryWrites=true&w=majority

# JWT Secret (change this in production!)
JWT_SECRET=tailoredtimes_dev_secret_key_change_in_production_abc123xyz

# JWT Expiry
JWT_EXPIRES_IN=7d

# Admin email
ADMIN_EMAIL=timestailored@gmail.com

# Email Notifications (Nodemailer)
# Fill these in to enable registration email notifications
# Use Gmail App Password (not your regular Gmail password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here
NOTIFY_EMAIL=timestailored@gmail.com

# NewsAPI.org key (optional - get free at newsapi.org)
# Without this, app runs in RSS-only mode with 60+ sources
NEWS_API_KEY=

# Guardian API key (optional - get free at open-platform.theguardian.com)
# Used for 10-year archive
GUARDIAN_API_KEY=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5000
